# Пример настроек. Настоящий .env создаётся сам при первом запуске.
SECRET_KEY=замените-на-длинную-случайную-строку
PIN_RUKOVODITEL=0000
PIN_MANAGER1=0000
PIN_MANAGER2=0000
PIN_BRIGADA1=0000
PIN_BRIGADA2=0000
# Логины для входа (необязательно). Если не заданы, логин = внутреннее имя:
# rukovoditel, manager1, manager2, brigada1, brigada2. Большие и маленькие буквы не важны.
# LOGIN_RUKOVODITEL=
# LOGIN_MANAGER1=
# LOGIN_MANAGER2=
# LOGIN_BRIGADA1=
# LOGIN_BRIGADA2=
# Имена для шапки сайта (необязательно). Если не заданы, показывается должность.
# NAME_RUKOVODITEL=
# NAME_MANAGER1=
# NAME_MANAGER2=
# NAME_BRIGADA1=
# NAME_BRIGADA2=
TZ_OFFSET_HOURS=5
# На хостинге с https поставьте 1: cookie входа не будет уходить по незащищённому http.
COOKIE_SECURE=0
# Технический вход суперадмина (/tech/vhod). Пароль не короче 12 символов.
# Без этих строк технический раздел выключен и отвечает «страница не найдена».
SUPERADMIN_LOGIN=
SUPERADMIN_PASSWORD=
